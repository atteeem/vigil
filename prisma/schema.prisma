// Vigil — local-development database schema.
//
// SQLite/Prisma is TEMPORARY local-development infrastructure (see
// Decisions.md in the Obsidian vault, "Current backend strategy"). This
// schema is a separate, parallel layer for the source-ingestion pipeline
// and admin review workflow — it does not replace the existing mock-data
// layer (lib/data/*) that the globe/map/conflict pages already read from.
// "Published" events from here are merged into the live event feed
// alongside mock data (see lib/data/world-events.ts).
//
// SQLite has no native enum type, so every enum-shaped field below is a
// plain String, validated/typed at the TypeScript boundary instead (see
// lib/types/db.ts) — the same "validate at the boundary" pattern
// ARCHITECTURE.md already uses for the mock-data Zod schemas.
//
// Field names intentionally mirror DATA_MODEL.md's target Postgres schema
// where the shapes overlap, so a future Supabase migration stays close to
// mechanical; where this schema is richer (source management fields for
// the admin UI), that's noted inline.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads
// `url` from this file) and the runtime PrismaClient connects via a driver
// adapter (see lib/db/client.ts), not this block — `provider` here only
// tells Prisma which SQL dialect to generate for.
datasource db {
  provider = "sqlite"
}

model Source {
  id          String   @id @default(cuid())
  name        String
  type        String // e.g. "rss" | "telegram" | "manual" — see lib/types/db.ts SourceType
  url         String?
  telegramHandle String? @map("telegram_handle")
  country     String?
  region      String?
  language    String?
  sourceCategory String? @map("source_category")
  reliabilityTier String? @map("reliability_tier")
  // Trust-model classification (spec "Source Trust Model") — a coarser,
  // controlled-vocabulary sibling of the free-text sourceCategory/
  // reliabilityTier fields above: "originating" | "relay" | "official" |
  // "local_media" | "eyewitness_community" | "aggregator". See
  // lib/types/db.ts SOURCE_ROLES. Nullable — existing sources predate this
  // field.
  sourceRole  String?  @map("source_role")
  permissionStatus String @default("unauthorized") @map("permission_status")
  enabled     Boolean  @default(true)
  autoIngest  Boolean  @default(false) @map("auto_ingest")
  // Gates the automated draft-extraction stage (lib/ingestion/draft.ts) —
  // "for sources where automated processing is allowed" per spec. Distinct
  // from autoIngest (fetching); a source can fetch without draft
  // suggestions being generated, or vice versa.
  autoProcessing Boolean @default(true) @map("auto_processing")
  // Scheduler fields (spec "Source Scheduler") — see lib/ingestion/scheduler.ts.
  pollIntervalMinutes Int @default(5) @map("poll_interval_minutes")
  nextPollAt  DateTime? @map("next_poll_at")
  lastAttemptedAt DateTime? @map("last_attempted_at")
  // Consecutive failed polls, reset to 0 on success — drives the
  // scheduler's exponential backoff (capped), not shown directly in the UI.
  consecutiveFailures Int @default(0) @map("consecutive_failures")
  lastSuccessfulIngestion DateTime? @map("last_successful_ingestion")
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rawItems    RawIngestionItem[]
  ingestionLogs IngestionLog[]

  @@map("sources")
}

// Append-only per-poll-attempt log (spec "Source Health": last attempted
// fetch, errors today, new items today) — Source's own lastAttemptedAt/
// lastSuccessfulIngestion/lastError fields stay as fast denormalized
// "current state" reads; this table is what lets the admin UI show
// today's aggregate counts without re-deriving them from raw_ingestion_items
// (which only records successes, never failed attempts).
model IngestionLog {
  id           String   @id @default(cuid())
  sourceId     String   @map("source_id")
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  attemptedAt  DateTime @default(now()) @map("attempted_at")
  fetched      Int      @default(0)
  newCount     Int      @default(0) @map("new_count")
  alreadyKnown Int      @default(0) @map("already_known")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")

  @@index([sourceId, attemptedAt])
  @@map("ingestion_logs")
}

model RawIngestionItem {
  id              String   @id @default(cuid())
  sourceId        String   @map("source_id")
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String   @map("external_id")
  originalUrl     String?  @map("original_url")
  originalTitle   String?  @map("original_title")
  originalText    String?  @map("original_text")
  language        String?
  publishedAt     DateTime? @map("published_at")
  receivedAt      DateTime @default(now()) @map("received_at")
  mediaUrls       String?  @map("media_urls") // JSON-encoded string[]
  processingStatus String  @default("pending") @map("processing_status")
  rawMetadata     String?  @map("raw_metadata") // JSON-encoded

  // Automated-suggestion SNAPSHOT (spec "Processing": "all new eligible
  // incoming items should automatically run through the existing
  // draft-processing system when source.autoProcessing = true") — computed
  // once by lib/ingestion/poll.ts right after ingestion, purely to make the
  // /admin/incoming queue filterable/sortable by conflict/region/event
  // type/importance without an N-way live recompute on every list request.
  // The review screen (GET /api/admin/incoming/[id]/draft) still always
  // recomputes fresh from lib/ingestion/draft.ts — this snapshot is never
  // the source of truth a human reviews, only a fast index. Duplicate
  // likelihood is deliberately NOT snapshotted here (see
  // ARCHITECTURE.md) — it's recomputed at list-read time instead, since a
  // duplicate can newly appear from an event published after this item
  // arrived, and a stale "no duplicate" snapshot would be actively unsafe.
  suggestedEventType String? @map("suggested_event_type")
  suggestedConflictId String? @map("suggested_conflict_id")
  suggestedRegion String? @map("suggested_region")
  suggestedCountryCode String? @map("suggested_country_code")
  suggestedLocationName String? @map("suggested_location_name")
  suggestedLat    Float?   @map("suggested_lat")
  suggestedLng    Float?   @map("suggested_lng")
  suggestedSeverity String? @map("suggested_severity")
  suggestedImportance Int?  @map("suggested_importance")
  locationSource  String?  @map("location_source") // "resolved" | "ambiguous" | "none"
  processedAt     DateTime? @map("processed_at")

  eventLinks      EventSource[]

  @@unique([sourceId, externalId])
  @@map("raw_ingestion_items")
}

model Conflict {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String?  @map("short_name")
  region      String
  // "active" | "dormant" | "resolved" | "archived" — enable/disable/archive
  // (spec §1) is implemented as status transitions rather than a separate
  // flag, so there's one place that governs whether a conflict is
  // selectable in the review/publish conflict picker (active + dormant
  // only — see app/api/admin/conflicts/route.ts).
  status      String   @default("active")
  severity    String
  intensity   Int
  intensityChange24h Int @default(0) @map("intensity_change_24h")
  startedAt   DateTime? @map("started_at")
  lat         Float?
  lng         Float?
  primaryEffects String? @map("primary_effects") // JSON-encoded string[]
  countries   String?  // JSON-encoded string[] of ISO country codes
  summary     String?  // doubles as "description" per spec §1's field list
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events      Event[]

  @@map("conflicts")
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  eventType   String   @map("event_type")
  locationName String? @map("location_name")
  latitude    Float
  longitude   Float
  countryCode String?  @map("country_code")
  region      String?
  conflictId  String?  @map("conflict_id")
  conflict    Conflict? @relation(fields: [conflictId], references: [id])
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  severity    String
  importance  Int      @default(50)
  verificationStatus String @default("unverified") @map("verification_status")
  published   Boolean  @default(false)

  sources     EventSource[]

  @@map("events")
}

model EventSource {
  id                 String   @id @default(cuid())
  eventId            String   @map("event_id")
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rawIngestionItemId String   @map("raw_ingestion_item_id")
  rawIngestionItem   RawIngestionItem @relation(fields: [rawIngestionItemId], references: [id], onDelete: Cascade)
  relationship       String   @default("originating") // "originating" | "relay" | "corroborating"
  isOriginatingSource Boolean @default(true) @map("is_originating_source")

  @@unique([eventId, rawIngestionItemId])
  @@map("event_sources")
}
