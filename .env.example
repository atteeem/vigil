# MapTiler API key for the /world operational map's vector basemap
# (Intel/Street/Satellite modes). Get a free key at
# https://cloud.maptiler.com/account/keys/
#
# Without a key, the map falls back to the offline-safe dark basemap for
# every mode (Street/Satellite just won't look distinct from Intel yet) —
# the app never breaks without this set, it just looks plainer.
#
# Copy this file to .env.local and fill in your real key there.
# Never commit a real key — .env.local is gitignored.
NEXT_PUBLIC_MAPTILER_KEY=

# Admin auth (Pre-Launch Critical Correctness & Security v1) — the entire /admin and /api/admin surface
# is gated by middleware.ts on these. Single shared password, single-owner beta; NOT the existing
# localStorage consumer account system, which is client-only preferences and never gated server access.
# Generate real values with e.g. `openssl rand -base64 32` — never commit real values, only fill them
# into .env.local (gitignored).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Lets the Playwright suite authenticate without a real password — only works when NODE_ENV is NOT
# "production" (checked in lib/admin/auth.ts), so a leaked/misconfigured value in a real deployment still
# can't be used to bypass login. Only playwright.config.ts should ever set this.
ADMIN_TEST_BYPASS_SECRET=

# Database (PostgreSQL via Prisma — Supabase in production). Two different
# connection strings on purpose (see prisma.config.ts and lib/db/client.ts):
# DATABASE_URL is the app's own runtime connection — Supabase's pooled
# Transaction Pooler URL (port 6543), sized for many short-lived
# serverless-style connections. DIRECT_URL is used only by the Prisma CLI
# (generate/migrate/studio) — Supabase's Session Pooler URL (port 5432),
# since migrations need a real session-held connection. Never commit real
# values — fill them into .env.local (gitignored) instead.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# How often (ms) the scheduler CHECKS which sources are due to poll —
# not each source's own poll interval, which is per-source
# (Source.pollIntervalMinutes, default 5min for RSS, editable in
# /admin/sources). Default 30s.
SCHEDULER_TICK_INTERVAL_MS=30000

# GEOCODING_PROVIDER=fixture forces the gazetteer-only geocoding provider
# (no live Nominatim calls) — set by playwright.config.ts for the
# deterministic test suite; leave unset for real local dev.
GEOCODING_PROVIDER=

# Telegram MTProto credentials (spec "Telegram architecture") — required
# only for the three pre-registered Telegram sources (@lumsrc, @dnipro_now,
# @huyovy_kharkiv) to actually ingest; every other source works without
# these. Get api_id/api_hash from https://my.telegram.org, then run the
# teleproto quick-start login flow once locally to obtain a session
# string. NEVER commit real values here — this file is the template only,
# fill real ones into .env.local (gitignored).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=


# Local-development ingestion controls (all optional)
# DISABLE_INGESTION_SCHEDULER=1        # do not start the background source poller (browse without any ingestion load)
# INGESTION_MAX_CONCURRENCY=4          # sources fetched at once
# INGESTION_MAX_SOURCES_PER_TICK=12    # sources started per 30 s tick in development (unlimited in production)
# INGESTION_FETCH_TIMEOUT_MS=20000     # hard per-feed timeout (the request is aborted)
